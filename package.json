{
  "name": "@starsharryzhu/dsh-assistant",
  "version": "0.2.0",
  "description": "A general-purpose chat agent for DeepSeek Harness built on a parent-agent + worker sub-agent architecture: the parent plans, delegates, manages worker context, model and reasoning effort, workspace, and permission approval, and reports results. Requires DeepSeek Harness Desktop >=0.2.1-rc.5 <0.3.0.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "parent-agent",
    "worker",
    "agent-preset"
  ],
  "author": "Starfield (https://github.com/StarsHarryZhu)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./bundle": {
      "types": "./lib/bundle.d.ts",
      "default": "./lib/bundle.js"
    },
    "./policy": {
      "types": "./lib/policy.d.ts",
      "default": "./lib/policy.js"
    },
    "./compactor": {
      "types": "./lib/compactor.d.ts",
      "default": "./lib/compactor.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README-zh.md",
    "AGENTS.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "link-dev": "node scripts/link-dev.mjs",
    "build": "node build.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.client.json",
    "test": "node build.js && node node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@starsharryzhu/complete-subagent": "0.1.0",
    "@starsharryzhu/im-robot": "0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarsHarryZhu/dsh-assistant.git"
  },
  "homepage": "https://github.com/StarsHarryZhu/dsh-assistant#readme",
  "bugs": {
    "url": "https://github.com/StarsHarryZhu/dsh-assistant/issues"
  },
  "license": "MIT"
}
